generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["calls_service", "references_service", "auth_service", "orders_service", "audit_logs", "error_logs"]
}

// ─────────────────────────────────────────
// Schema: references_service (read-only)
// ─────────────────────────────────────────

model City {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  phones  Phone[]
  calls   Call[]

  @@schema("references_service")
  @@map("cities")
}

model Rk {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(50)
  name     String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  phones Phone[]
  calls  Call[]

  @@schema("references_service")
  @@map("rk")
}

// ─────────────────────────────────────────
// Schema: auth_service (read-only)
// ─────────────────────────────────────────

model Operator {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  login      String    @unique @db.VarChar(255)
  role       String    @db.VarChar(50)
  status     String    @db.VarChar(50)
  sipAddress String?   @map("sip_address") @db.VarChar(255)
  cityIds    Int[]     @default([]) @map("city_ids")
  deletedAt  DateTime? @map("deleted_at")

  calls Call[]

  @@schema("auth_service")
  @@map("operators")
}

model Master {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  login     String?   @unique @db.VarChar(255)
  role      String    @db.VarChar(50)
  status    String    @db.VarChar(50)
  cityIds   Int[]     @default([]) @map("city_ids")
  deletedAt DateTime? @map("deleted_at")

  calls Call[]

  @@schema("auth_service")
  @@map("masters")
}

// ─────────────────────────────────────────
// Schema: orders_service (read-only, for cross-service lookups)
// ─────────────────────────────────────────

model Order {
  id              Int       @id @default(autoincrement())
  cityId          Int       @map("city_id")
  rkId            Int       @map("rk_id")
  phone           String    @db.VarChar(20)
  orderTypeId     Int       @map("order_type_id")
  clientName      String    @map("client_name") @db.VarChar(255)
  address         String    @db.Text
  dateMeeting     DateTime  @map("date_meeting")
  equipmentTypeId Int       @map("equipment_type_id")
  problem         String    @db.Text
  statusId        Int       @map("status_id")
  operatorId      Int       @map("operator_id")
  masterId        Int?      @map("master_id")
  result          Decimal?  @db.Decimal(10, 2)
  expenditure     Decimal?  @db.Decimal(10, 2)
  clean           Decimal?  @db.Decimal(10, 2)
  masterChange    Decimal?  @map("master_change") @db.Decimal(10, 2)
  prepayment      Decimal?  @db.Decimal(10, 2)
  callId          String?   @map("call_id") @db.VarChar(100)
  appealId        Int?      @map("appeal_id")
  dateCloseMod    DateTime? @map("date_close_mod")
  closingAt       DateTime? @map("closing_at")
  version         Int       @default(1)
  hasPoverka      Boolean   @default(false) @map("has_poverka")

  @@schema("orders_service")
  @@map("orders")
}

// ─────────────────────────────────────────
// Schema: calls_service
// ─────────────────────────────────────────

/// Телефонные номера (привязка к РК)
model Phone {
  id        Int      @id @default(autoincrement())
  number    String   @unique @db.VarChar(20)
  cityId    Int      @map("city_id")
  rkId      Int      @map("rk_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id])
  rk   Rk   @relation(fields: [rkId], references: [id])

  @@index([cityId])
  @@index([rkId])
  @@schema("calls_service")
  @@map("phones")
}

model Appeal {
  id          Int       @id @default(autoincrement())
  operatorId  Int       @map("operator_id")
  cityId      Int       @map("city_id")
  phone       String    @db.VarChar(20)
  category    String    @db.VarChar(50)
  description String?   @db.Text
  result      String?   @db.Text
  status      String    @default("new") @db.VarChar(50)
  sourceType  String    @map("source_type") @db.VarChar(20)
  callId      Int?      @map("call_id")
  siteOrderId Int?      @map("site_order_id")
  orderId     Int?      @map("order_id")
  callbackAt  DateTime? @map("callback_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  calls Call[]

  @@index([operatorId])
  @@index([phone])
  @@index([status])
  @@index([category])
  @@index([callbackAt])
  @@index([sourceType])
  @@index([cityId, status])
  @@index([operatorId, createdAt])
  @@index([phone, createdAt])
  @@index([status, callbackAt])
  @@schema("calls_service")
  @@map("appeals")
}

/// Звонки (интеграция с Mango)
model Call {
  id                   Int       @id @default(autoincrement())
  cityId               Int       @map("city_id")
  rkId                 Int       @map("rk_id")
  callDirection        String    @map("call_direction") @db.VarChar(20)
  status               String    @db.VarChar(50)
  phoneClient          String    @map("phone_client") @db.VarChar(20)
  phoneAts             String    @map("phone_ats") @db.VarChar(20)
  recordingPath        String?   @map("recording_path") @db.VarChar(500)
  recordingProcessedAt DateTime? @map("recording_processed_at")
  duration             Int?
  callId               String?   @unique @map("call_id") @db.VarChar(100)
  mangoData            Json?     @map("mango_data") @db.JsonB
  operatorId           Int       @map("operator_id")
  masterId             Int?      @map("master_id")
  directorId           Int?      @map("director_id")
  note                 String?   @db.Text
  appealId             Int?      @map("appeal_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  city     City      @relation(fields: [cityId], references: [id])
  rk       Rk        @relation(fields: [rkId], references: [id])
  operator Operator  @relation(fields: [operatorId], references: [id])
  master   Master?   @relation(fields: [masterId], references: [id])
  appeal   Appeal?   @relation(fields: [appealId], references: [id])

  @@index([operatorId])
  @@index([masterId])
  @@index([directorId])
  @@index([createdAt])
  @@index([status])
  @@index([phoneClient])
  @@index([cityId])
  @@index([rkId])
  @@index([callDirection])
  @@index([appealId])
  @@index([cityId, createdAt])
  @@index([cityId, status])
  @@index([operatorId, createdAt])
  @@index([phoneClient, createdAt])
  @@index([cityId, callDirection])
  @@schema("calls_service")
  @@map("calls")
}

// ─────────────────────────────────────────
// Schema: audit_logs
// ─────────────────────────────────────────

model AuditCalls {
  id        Int      @id @default(autoincrement())
  eventType String   @map("event_type") @db.VarChar(100)
  userId    Int?     @map("user_id")
  role      String?  @db.VarChar(50)
  login     String?  @db.VarChar(255)
  ip        String   @db.VarChar(45)
  userAgent String   @map("user_agent") @db.Text
  success   Boolean
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
  @@index([success])
  @@index([role, createdAt])
  @@schema("audit_logs")
  @@map("audit_calls")
}

// ─────────────────────────────────────────
// Schema: error_logs
// ─────────────────────────────────────────

model ErrorCalls {
  id            Int      @id @default(autoincrement())
  errorType     String   @map("error_type") @db.VarChar(255)
  errorMessage  String   @map("error_message") @db.Text
  stackTrace    String?  @map("stack_trace") @db.Text
  userId        Int?     @map("user_id")
  userRole      String?  @map("user_role") @db.VarChar(50)
  requestUrl    String?  @map("request_url") @db.VarChar(500)
  requestMethod String?  @map("request_method") @db.VarChar(10)
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([errorType])
  @@index([userId])
  @@index([createdAt])
  @@index([userRole, createdAt])
  @@schema("error_logs")
  @@map("error_calls")
}
